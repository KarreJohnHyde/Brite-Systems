# Copy this file to .env. The checked-in defaults are credential-free,
# deterministic, and keep questions and policy excerpts on this machine.

# Source and generated artifacts (relative paths assume commands run at repo root)
CORPUS_PATH=data/policy-manual.md
# Amendment No. 2026-01 is a separate authoritative source. Set to
# none only when intentionally running an alternate standalone corpus.
AMENDMENT_PATH=data/amendment-2026-01.md
POLICY_TIMELINE_PATH=data/policy_timeline.json
PROCESSED_PATH=data/processed/chunks.json
CORPUS_REPORT_PATH=data/processed/corpus-report.json
INDEX_DIR=data/indexes
POLICY_FINDINGS_PATH=data/policy_findings.json
CONTACTS_PATH=data/contacts.json

# Safe default retrieval: local stable-hashing vectors + lexical BM25 fusion
EMBEDDING_BACKEND=hashing
EMBEDDING_DIMENSION=768
EMBEDDING_MODEL=stable-hashing-768
ENABLE_HYBRID_SEARCH=true
ENABLE_NEIGHBOR_RETRIEVAL=true
INITIAL_RETRIEVAL_K=18
RERANK_K=8
FINAL_K=6
RRF_K=60

# Optional local CrossEncoder reranking. This downloads/loads the named model.
ENABLE_RERANKING=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Fail closed at startup or prediction time when an enabled reranker is unavailable.
REQUIRE_RERANKER=false

# Evidence and safety controls. Change only after running calibration/evaluation.
REFUSAL_THRESHOLD=0.58
DIRECT_COVERAGE_THRESHOLD=0.34
ENABLE_CONTRADICTION_CHECK=true
ENABLE_CLAIM_VALIDATION=true

# Safe default answer builder. It uses trusted source text without an API call.
LLM_PROVIDER=deterministic

# Optional answer phrasing providers. The Streamlit app can also accept these
# credentials for the current session without writing them to this file.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=minimal
GEMINI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
# Llama is hosted through Groq. Either variable name is accepted.
LLAMA_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
LLAMA_API_KEY=
GROQ_API_KEY=

# Optional content-redacted LangSmith tracing for the custom pipeline. This
# credential enables observability; it is not an embedding-model API key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Legacy alias accepted for compatibility.
LANGCHAIN_API_KEY=
LANGSMITH_PROJECT=grounded-answer
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=

LOG_LEVEL=WARNING
